# Canonical public URL. Leave blank for the initial Vercel URL, then replace it
# with the owner-confirmed custom domain when that domain is connected.
NEXT_PUBLIC_SITE_URL=""

# Optional Siriranee booking provider. Leave both values blank until the owner
# confirms the live scheduler. Blank values keep the safe booking/contact flow.
NEXT_PUBLIC_BOOKING_URL=""
NEXT_PUBLIC_ACUITY_OWNER_ID=""

# Optional owner-confirmed public channels. Leave blank to hide the action.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_BOOKSY_URL=""
NEXT_PUBLIC_GOOGLE_REVIEW_URL=""

# Optional. International digits only, without a leading plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# CMS persistence. Keep disabled in production until MongoDB and the first
# administrator have been configured. Use mock only for local development.
CMS_MODE=""
MONGODB_URI=""
MONGODB_DB="siriranee"
CMS_ORIGIN=""
CMS_COOKIE_SECURE=""

# Cloudinary image library. Keep the readiness gate false until all values are
# configured in the hosting provider and CMS_MODE is mongodb. The API secret and
# token secret are server-only and must never use a NEXT_PUBLIC_ prefix.
CMS_MEDIA_UPLOAD_READY="false"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_FOLDER="siriranee/cms"
CMS_MEDIA_TOKEN_SECRET=""

# Used only by the one-time administrator provisioning command. Usernames are
# stored in lowercase and contain 4-32 ASCII letters or numbers. Passwords
# contain 12-256 ASCII letters or numbers with no required mixture. Display
# names contain 2-80 characters. Set these temporarily in the shell, run the
# command, then remove them.
CMS_SEED_USERNAME=""
CMS_SEED_PASSWORD=""
CMS_SEED_DISPLAY_NAME=""
CMS_SEED_ROLE="administrator"

# Final server-side gate for direct website bookings. Keep false until the
# owner has confirmed opening hours and booking rules in the CMS, MongoDB
# indexes are installed, and the encrypted booking-data key is backed up.
CMS_PUBLIC_BOOKING_READY="false"

# Reserved for separately approved backup automation. Use an absolute private
# directory outside the public website. The backup key must decode to 32 bytes,
# must not be the PII key, and is not consumed by the current application.
CMS_BACKUP_DIRECTORY=""
CMS_BACKUP_ENCRYPTION_KEY=""

# Required only for live direct booking. Generate a secret 32-byte base64url
# or 64-character hexadecimal key. Never expose it as NEXT_PUBLIC.
CMS_PII_ENCRYPTION_KEY=""
